# Required
GEMINI_API_KEY=

# Strongly recommended on a public deployment (shared site password)
APP_PASSWORD=

# Optional model overrides
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
GEMINI_SYNTHESIS_MODEL=gemini-3.6-flash
LLM_TOKEN_BUDGET=2000000

# Email delivery (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_TO=

# Persistent run history on Vercel (Upstash Redis integration provides these)
KV_REST_API_URL=
KV_REST_API_TOKEN=
